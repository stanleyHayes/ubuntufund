{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": [
        "scripts/**/*.mjs",
        "__tests__/**/*.node-test.{ts,cts,mjs}"
      ],
      "ignoreDependencies": [
        "pino-pretty"
      ]
    },
    "apps/web": {
      "entry": [
        "__tests__/**/*.node-test.{ts,cts,mjs}"
      ]
    },
    "packages/ui": {
      "entry": [
        "__tests__/**/*.node-test.{ts,cts,mjs}"
      ]
    },
    ".": {
      "ignoreDependencies": [
        "react",
        "react-dom",
        "react-test-renderer"
      ]
    },
    "apps/mobile": {
      "ignoreDependencies": [
        "react-native-vector-icons"
      ]
    }
  }
}
