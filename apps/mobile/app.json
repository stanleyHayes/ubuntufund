{
  "expo": {
    "name": "Ujimora",
    "slug": "ubuntu-fund",
    "scheme": "ujimora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E7D32"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ujimora.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "package": "com.ujimora.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "ujimora"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#2E7D32",
          "defaultChannel": "default"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your Ujimora campaigns, profile and verification.",
          "cameraPermission": "Take a photo for your campaign, profile or identity verification.",
          "microphonePermission": "Broadcast your voice in live campaign sessions."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Use your location to fill your verification address."
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "enableScreenShareService": true
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Broadcast your camera to Ujimora viewers.",
          "microphonePermission": "Broadcast your voice to Ujimora viewers."
        }
      ],
      "./plugins/withBroadcastExtension"
    ]
  }
}
