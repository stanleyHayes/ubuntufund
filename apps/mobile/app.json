{
  "expo": {
    "name": "UbuntuFund",
    "slug": "ubuntu-fund",
    "scheme": "ubuntufund",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E7D32"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ubuntufund.app",
      "associatedDomains": [
        "applinks:ubuntufund.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E7D32"
      },
      "package": "com.ubuntufund.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ubuntufund.com",
              "pathPrefix": "/campaigns"
            },
            {
              "scheme": "ubuntufund"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "notification": {
      "vapidPublicKey": "BNM8Xg2klofkUZfe2lXC80wFGQVSQj7ojDcn8mlLPQfDfuY4dIBcr5qpxggHMPzv53GwQ4xapuPIR3sQoXV0TuI"
    }
  }
}
