PORT=4000
MONGODB_URI=mongodb://localhost:27017/ubuntu-fund
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
# Comma-separated browser origins allowed by CORS (defaults to local dev ports in development)
CORS_ORIGINS=
# Public base URL of the donor-facing web app. Builds vanity `/c/:slug` targets,
# short-link destinations, and campaign canonical URLs.
# Local default: http://localhost:18200 · Production: https://app.ujimora.com
PUBLIC_WEB_URL=
# Public base URL this API is reachable at. Builds the short URLs QR codes encode
# (`${PUBLIC_API_URL}/r/:code`).
# Local default: http://localhost:<PORT> · Production: https://api.ujimora.com
PUBLIC_API_URL=
# Web Push (VAPID) — used when the server sends web push notifications.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Cloudinary (optional) — enables signed direct media uploads (POST /uploads/sign).
# Leave blank to disable uploads; the sign endpoint then returns 501.
# API_SECRET is a server-only secret — never expose it to the client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Donation fee policy. All default to 0 (beneficiary-net == donation amount).
# PLATFORM_FEE_PERCENT applies on every rail; the PAYSTACK_* values model the
# processor fee for the hosted-payment phase (the provider supplies the real
# fee at settlement time regardless).
PLATFORM_FEE_PERCENT=0
PAYSTACK_FEE_PERCENT=0
PAYSTACK_FLAT_FEE=0
# Paystack (card + mobile money in GHS for Ghana). When PAYSTACK_SECRET_KEY is
# blank the Paystack rail is DISABLED: POST /donation-intents with
# provider=paystack returns 501 and the webhook rejects everything — the wallet
# rail keeps working. The webhook (POST /api/v1/webhooks/paystack) verifies an
# HMAC-SHA512 signature made with the secret key, and PUBLIC_WEB_URL builds the
# donor's `/donate/callback` return URL.
# SECRET KEY IS SERVER-ONLY — never expose it to the browser/client bundle.
PAYSTACK_SECRET_KEY=
# Publishable key — safe to expose to the client (Paystack Inline checkout).
PAYSTACK_PUBLIC_KEY=
# Referral/affiliate commission policy. Commission is one-time on the referee's
# first paid subscription, accrues 'held', and matures to 'available' after the
# hold window. Defaults: 10% commission, 14-day hold.
AFFILIATE_COMMISSION_PERCENT=10
AFFILIATE_HOLD_DAYS=14
# ── Flutterwave (secondary/alternative rail — diaspora cards) ────────────────
# Blank secret key ⇒ the Flutterwave rail is DISABLED. Set the webhook secret
# hash to the value configured in the Flutterwave dashboard; the webhook
# (POST /api/v1/webhooks/flutterwave) compares it against the `verif-hash`
# header. SECRET KEY + HASH ARE SERVER-ONLY — never expose them to the client.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
# ── Multi-rail payments feature flags (spec §16) ─────────────────────────────
# All optional; defaults keep the working Ghana MoMo (Paystack) path unchanged.
# Turn rails/currencies on only when eligible — each is independently reversible.
PAYMENTS_PAYSTACK_ENABLED=true
PAYMENTS_FLUTTERWAVE_ENABLED=false
# International Visa/Mastercard via Paystack — enable ONLY after merchant
# eligibility is confirmed with the provider.
PAYMENTS_INTERNATIONAL_CARDS_ENABLED=false
# Accept/present non-GHS contribution currencies at checkout.
PAYMENTS_MULTI_CURRENCY_ENABLED=false
PAYMENTS_DEFAULT_PROVIDER=paystack
PAYMENTS_RECONCILIATION_ENABLED=true
# Currencies the checkout may present when multi-currency is on.
PAYMENTS_SUPPORTED_CURRENCIES=GHS,USD,GBP,EUR,CAD
# Label recorded on contributions for the FX rate source (e.g. provider|manual).
PAYMENTS_FX_SOURCE=provider

# ── Crypto donation rail (Crypto Donations plan §23) — OFF by default ──
# Needs provider onboarding + Ghana legal/compliance sign-off before enabling.
CRYPTO_PAYMENTS_ENABLED=false
CRYPTO_PRIMARY_PROVIDER=mock
CRYPTO_ALLOWED_ASSETS=USDT,USDC
CRYPTO_MIN_GHS=10
CRYPTO_MAX_GHS=100000
CRYPTO_QUOTE_TTL_SECONDS=900
CRYPTO_MOCK_WEBHOOK_SECRET=mock-crypto-webhook-secret-dev
# Real provider secrets (examples; use the exact names each adapter requires):
# YELLOWCARD_API_KEY=  YELLOWCARD_API_SECRET=  YELLOWCARD_WEBHOOK_SECRET=
# PAYCHANT_PARTNER_API_KEY=  PAYCHANT_WEBHOOK_SECRET=
# BITNOB_API_KEY=  BITNOB_WEBHOOK_SECRET=

# Real stablecoin receipt adapter. Empty networks/keys keep Bitnob unavailable.
# Current Bitnob HMAC API credentials (not the older Bearer-token API).
BITNOB_CLIENT_ID=
BITNOB_CLIENT_SECRET=
BITNOB_WEBHOOK_SECRET=
BITNOB_ALLOWED_NETWORKS=
# Ordered configured providers for quote-only failover; no deposit switching.
# Only bitnob is a real implemented adapter. mock is development/test only.
CRYPTO_FALLBACK_PROVIDERS=

# In-app video broadcasting (LiveKit Cloud). Server-only credentials.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI campaign writing (server only; never expose the key in VITE_ variables)
AI_WRITING_ENABLED=false
OPENAI_API_KEY=
AI_WRITING_MODEL=gpt-4.1-mini
AI_WRITING_DAILY_LIMIT=20
AI_WRITING_GLOBAL_DAILY_LIMIT=500
