PORT=4000
MONGODB_URI=mongodb://localhost:27017/ubuntu-fund
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
# Comma-separated browser origins allowed by CORS (defaults to local dev ports in development)
CORS_ORIGINS=
# Public base URL of the donor-facing web app. Builds vanity `/c/:slug` targets,
# short-link destinations, and campaign canonical URLs. (default: http://localhost:18200)
PUBLIC_WEB_URL=
# Public base URL this API is reachable at. Builds the short URLs QR codes encode
# (`${PUBLIC_API_URL}/r/:code`). (default: http://localhost:<PORT>)
PUBLIC_API_URL=
# Web Push (VAPID) — used when the server sends web push notifications.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Cloudinary (optional) — enables signed direct media uploads (POST /uploads/sign).
# Leave blank to disable uploads; the sign endpoint then returns 501.
# API_SECRET is a server-only secret — never expose it to the client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Donation fee policy. All default to 0 (beneficiary-net == donation amount).
# PLATFORM_FEE_PERCENT applies on every rail; the PAYSTACK_* values model the
# processor fee for the hosted-payment phase (the provider supplies the real
# fee at settlement time regardless).
PLATFORM_FEE_PERCENT=0
PAYSTACK_FEE_PERCENT=0
PAYSTACK_FLAT_FEE=0
# Paystack (card + mobile money in GHS for Ghana). When PAYSTACK_SECRET_KEY is
# blank the Paystack rail is DISABLED: POST /donation-intents with
# provider=paystack returns 501 and the webhook rejects everything — the wallet
# rail keeps working. The webhook (POST /api/v1/webhooks/paystack) verifies an
# HMAC-SHA512 signature made with the secret key, and PUBLIC_WEB_URL builds the
# donor's `/donate/callback` return URL.
# SECRET KEY IS SERVER-ONLY — never expose it to the browser/client bundle.
PAYSTACK_SECRET_KEY=
# Publishable key — safe to expose to the client (Paystack Inline checkout).
PAYSTACK_PUBLIC_KEY=
