# =====================================================================
# Ujimora — Donor Web App (Vite SPA, deployed to Vercel)
# Copy to `.env` for local dev. Only VITE_*-prefixed vars reach the
# browser bundle; keep secrets OUT of every frontend env file.
# =====================================================================

# API base URL used by the client.
# Local dev: "/api/v1" (the Vite dev server proxies it to API_PROXY_TARGET).
# Production (.env.production): the API origin, https://api.ujimora.com/api/v1,
# so the API sees each browser's own IP for rate limits. "/api/v1" still works
# there through the vercel.json rewrite, but every browser then shares
# Vercel's egress IP.
VITE_API_URL=/api/v1

# Dev-only: the Vite dev server proxies /api/v1 to this target.
# Not read in production builds. Passed via the shell in the dev script.
API_PROXY_TARGET=http://localhost:18100

# --- Cloudinary (unsigned image uploads for campaign cover photos) ---
# Public, browser-safe values for an UNSIGNED upload preset. When BOTH are set,
# image uploads (device → Cloudinary) turn on across the app; otherwise the
# uploader shows a disabled "not enabled yet" note. NEVER put a Cloudinary API secret in a VITE_* var.
# VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
# VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# --- Live updates (Server-Sent Events) ---
# Real-time donation/activity feeds connect to /api/v1/sse only when this is
# exactly "true". Leave unset to disable — the app degrades to static data
# silently (no failed-connection console noise).
# VITE_SSE_ENABLED=true
