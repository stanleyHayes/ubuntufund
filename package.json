{
  "name": "ubuntu-fund",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/apply-security-patches.cjs",
    "test:dependency-security": "node --test scripts/dependency-security.test.cjs",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:unused": "knip"
  },
  "dependencies": {
    "patch-package": "8.0.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "knip": "^6.35.1",
    "prettier": "^3.8.1",
    "react-test-renderer": "19.2.0",
    "turbo": "^2.8.21",
    "typescript": "^6.0.2"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "qs": "6.16.0",
    "xcode": {
      "uuid": "11.1.1"
    },
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "esbuild": "0.28.1",
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false
  }
}
